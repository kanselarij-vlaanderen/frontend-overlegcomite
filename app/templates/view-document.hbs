{{page-title
  (format-versioned-document-name @model.documentVersion @model.document)
}}

<object
  class="au-u-height-full"
  title="Document {{format-versioned-document-name
    @model.documentVersion
    @model.document
  }}"
  type={{@model.file.format}}
  data={{document-version/download-link @model.document @model.file "inline"}}
>
  <div class="au-o-region">
    <div class="au-o-layout">
      <AuAlert
        @icon="document"
        @skin="warning"
        @title="Kan document niet laden"
      >
        <AuContent @skin="small">
          <p>
            '{{format-versioned-document-name
              @model.documentVersion
              @model.document
            }}' kan niet in de browser bekeken worden.
          </p>
          <AuLinkExternal
            href={{document-version/download-link @model.document @model.file}}
            @skin="button"
            @icon="download"
          >
            Document downloaden
          </AuLinkExternal>
        </AuContent>
      </AuAlert>
    </div>
  </div>
</object>