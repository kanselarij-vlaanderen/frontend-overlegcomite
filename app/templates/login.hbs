<AuMainContainer @scroll={{true}} @size="small" as |main|>
  <main.content>
    <div class="au-u-flex au-u-flex--center au-u-flex--vertical-center au-u-margin-huge">
      <div class="au-u-max-width-small">
        <AuContent>
          <h1>Overlegcomité</h1>

          <p class="au-u-para-lead">Een webapplicatie die helpt bij het plannen en opvolgen van de agenda voor het Overlegcomité</p>

          <p class="au-u-para-small">Lukt het aanmelden niet? Neem contact op met uw interne beheerder. Indien er zich een probleem voordoet, contacteer <AuLinkExternal href="https://overheid.vlaanderen.be/ict/ict-diensten/gebruikersbeheer">gebruikersbeheer Vlaanderen</AuLinkExternal>.</p>
        </AuContent>

        <div class="au-u-margin-top">
          <AuLink
            @route="auth.login"
            @skin="button"
            @icon="login"
          >
            Aanmelden
          </AuLink>
        </div>
      </div>
    </div>
  </main.content>
</AuMainContainer>