{{page-title "Vergaderingen"}}

<AuToolbar @border="bottom" @size="large" as |Group|>
  <Group>
    <AuHeading @skin="2">Vergaderingen</AuHeading>
  </Group>
  <Group>
    <AuButton {{on "click" this.openNewMeetingModal}} @skin="primary" @icon="plus">
      Nieuwe vergadering
    </AuButton>
  </Group>
</AuToolbar>

<AuDataTable
  @content={{@model}}
  @fields="startedAt"
  @noDataMessage="Geen vergaderingen gevonden"
  @sort={{this.sort}}
  @page={{this.page}}
  @size={{this.size}}
  as |t|>
  <t.content as |c|>
    <c.header>
      <AuDataTableThSortable
        @field="startedAt"
        @currentSorting={{this.sort}}
        @label="Datum" @class="data-table-meeting-started-at"
        />
      <th>
      </th>
    </c.header>
    <c.body @onClickRow={{this.goToMeeting}} as |meeting|>
      <td>Agenda van {{format-datetime meeting.startedAt}}</td>
      <td class="au-u-text-center">
        <AuLink
          @route="meeting"
          @model={{meeting.id}}
          @icon="chevron-right"
          @hideText={{true}}>
          Ga naar vergadering
        </AuLink>
      </td>
    </c.body>
  </t.content>
</AuDataTable>

<AuModal
  @modalOpen={{this.isOpenNewMeetingModal}}
  @closeModal={{this.closeNewMeetingModal}}
  @overflow={{true}}>
  <:title>
    Nieuwe vergadering
  </:title>
  <:body>
    <MeetingForm @meeting={{this.newMeeting}} />
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.closeNewMeetingModal}} @skin="naked">
        Annuleren
      </AuButton>
      <AuButton
        @skin="primary"
        @loading={{this.saveNewMeeting.isRunning}}
        {{on "click" this.saveNewMeeting.perform}}>
        Aanmaken
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>

{{outlet}}