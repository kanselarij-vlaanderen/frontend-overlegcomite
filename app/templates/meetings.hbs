{{page-title "Vergaderingen"}}

<AuMainContainer as |m|>
  <m.content>
    <div class="au-o-layout">
      <Request @query={{this.meetingsQuery}}>
        <:content as |result|>
          <AuHeading>Vergaderingen</AuHeading>
          <AuDataTable
            @content={{result.data}}
            @fields="startedAt"
            as |t|>
            <t.content as |c|>
              <c.header>
                <AuDataTableThSortable
                  @field="startedAt"
                  @currentSorting={{this.sort}}
                  @label="Datum" @class="data-table__header-date"
                />
              </c.header>
              <c.body as |meeting|>
                <td>{{meeting.startedAt}}</td>
              </c.body>
            </t.content>
          </AuDataTable>
        </:content>
      </Request>
    </div>
  </m.content>
</AuMainContainer>

{{outlet}}