{{page-title "Vergaderingen"}}

<AuToolbar @border="bottom" @size="large" as |Group|>
  <Group>
    <AuHeading @skin="2">Vergaderingen</AuHeading>
  </Group>
  <Group>
    <AuButton {{on "click" this.openNewMeetingModal}} @skin="primary" @icon="plus">
      Nieuwe vergadering
    </AuButton>
  </Group>
</AuToolbar>

<AuDataTable
  @content={{format-content-for-au-datable this.model.content}}
  @fields="startedAt"
  @noDataMessage="Geen vergaderingen gevonden"
  @sort={{this.sort}}
  @page={{this.page}}
  @size={{this.size}}
  as |t|>
  <t.content as |c|>
    <c.header>
      <AuDataTableThSortable
        @field="startedAt"
        @currentSorting={{this.sort}}
        @label="Datum" @class="data-table__header-date"
        />
      <th>
      </th>
    </c.header>
    <c.body @onClickRow={{this.goToMeeting}} class="cursor-pointer" as |meeting|>
      <td>{{datetime-format meeting.startedAt}}</td>
      <td>
        <AuLink
          @route="meeting"
          @model={{meeting}}
          @icon="arrow-right"
          @iconAlignment="right">
          Ga naar vergadering
        </AuLink>
      </td>
    </c.body>
  </t.content>
</AuDataTable>

<AuModal
  @modalOpen={{this.isOpenNewMeetingModal}}
  @closeModal={{this.closeNewMeetingModal}}
  @overflow={{true}}>
  <:title>
    Nieuwe vergadering
  </:title>
  <:body>
    <MeetingForm @meeting={{this.newMeeting}} />
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.closeNewMeetingModal}} @skin="link-bold">
        Annuleren
      </AuButton>
      <AuButton
        @skin="primary"
        @loading={{this.saveState.isPending}}
        {{on "click" this.saveNewMeeting}}>
        Aanmaken
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>

{{outlet}}