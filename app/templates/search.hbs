{{page-title "Zoeken"}}

<div class="oc-search-header au-u-padding-bottom">
  <AuToolbar @size="medium" @skin="tint" as |Group|>
    <Group>
      <AuHeading @skin="2">Zoeken naar agendapunten</AuHeading>
    </Group>
  </AuToolbar>
  <AuToolbar @size="medium" @skin="tint" as |Group|>
    <Group class="au-u-flex-grow">
      <div class="au-o-grid au-o-grid--small au-o-grid--middle au-u-1-1">
        <div class="au-o-grid__item au-u-1-2@small">
          <AuInput
            id="search-text"
            placeholder="Zoekterm"
            value={{this.searchTextInput}}
            @icon="search"
            @iconAlignment="right"
            @width="block"
            class="oc-u-subtle-progress-bar"
            {{this.asProgressBar}}
            {{on "input" (with-value (fn (mut this.searchTextInput)))}}
          />
        </div>
        <div class="au-o-grid__item au-u-1-2@small">
          <AuToggleSwitch
            @checked={{this.notificationsOnly}}
            @onChange={{fn (mut this.notificationsOnly)}}
          >
            Uitsluitend in notificaties zoeken
          </AuToggleSwitch>
        </div>
      </div>
    </Group>
  </AuToolbar>
</div>

{{#if this.isLoadingModel}}
  <AuLoader>
    Aan het zoeken
  </AuLoader>
{{else}}
  <AuDataTable
    @content={{@model.data}}
    @noDataMessage="Geen agendapunten gevonden"
    @sort={{this.sort}}
    @page={{this.page}}
    @size={{this.size}}
    as |t|
  >
    <t.content as |c|>
      <c.header>
        <AuDataTable::ThSortable
          @field="meetingDate"
          @currentSorting={{this.sort}}
          @label="Vergadering"
        />
        <th class="data-table-search-agendaitems-subject">
          Onderwerp
        </th>
        <th class="data-table-row-navigation" />
      </c.header>
      <c.body as |agendaitem|>
        <td>
          Vergadering van
          {{format-datetime agendaitem.meetingDate}}
        </td>
        <td>
          {{agendaitem.subject}}
        </td>
        <td class="au-u-text-center">
          <AuLink
            @route="meeting.agendaitems.agendaitem"
            @models={{array
              (or agendaitem.meetingId "NO_MEETING_ID")
              agendaitem.id
            }}
            @icon="chevron-right"
            @hideText={{true}}
          >
            Ga naar agendapunt
          </AuLink>
        </td>
      </c.body>
    </t.content>
  </AuDataTable>
{{/if}}