{{page-title "Overlegcomité" separator=" | " prepend=true}}

<AuModalContainer />

<AuApp>
  <AuMainHeader
    @brandLink="https://www.vlaanderen.be/nl"
    @homeRoute="index"
    @appTitle="Overlegcomité">
  </AuMainHeader>
  <AuToolbar @skin="tint">
    <AuTabs as |Tab|>
      <Tab>
        <AuLink @route="meetings">Vergaderingen</AuLink>
      </Tab>
      <Tab>
        <AuLink @route="index">Zoeken</AuLink>
      </Tab>
      <Tab>
        <AuLink @route="index">Gebruikersbeheer</AuLink>
      </Tab>
    </AuTabs>
  </AuToolbar>

  <AuMainContainer @scroll="true" @size="regular" as |main|>
    <main.content>
      <AuBodyContainer>
        {{outlet}}
      </AuBodyContainer>
    </main.content>
  </AuMainContainer>
</AuApp>