<div class="au-u-padding">
  <AuToolbar @size="medium" @border="bottom" as |Group|>
    <Group>
      <AuHeading @level={{4}} @skin={{4}}>
        Agendapunt
        {{#if @model.case.identifier}}
          <AuPill class="au-u-margin-left-tiny">
            {{@model.case.identifier}}
          </AuPill>
        {{/if}}
      </AuHeading>
    </Group>
    {{#if (user-may "manage-agendaitems")}}
      <Group>
        <AuButton
          @skin="secondary"
          @icon="pencil"
          {{on "click" this.openEditAgendaitemModal}}
        >
          Wijzigen
        </AuButton>
        <AuButton
          @skin="secondary"
          @icon="trash"
          @alert={{true}}
          {{on "click" this.openDeleteAgendaitemModal}}
        >
          Verwijderen
        </AuButton>
      </Group>
    {{/if}}
  </AuToolbar>
</div>

<div class="oc-container">
  <span class="au-u-newlines au-u-medium">{{@model.subject}}</span>
</div>

<div class="oc-container au-o-flow--large">
  <AgendaitemDocuments @agendaitem={{@model}} />
</div>

<AuModal
  @modalOpen={{this.isOpenEditAgendaitemModal}}
  @closeModal={{this.cancelEditAgendaitem}}
  @overflow={{true}}
>
  <:title>
    Agendapunt wijzigen
  </:title>
  <:body>
    <Await @promise={{@model.case}}>
      <:pending>
        <AuLoader @centered={{true}}>
          Aan het laden
        </AuLoader>
      </:pending>
      <:success>
        <AgendaitemForm
          @agendaitem={{@model}}
          @caseIdentifier={{this.caseIdentifier}}
        />
      </:success>
    </Await>
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.cancelEditAgendaitem}} @skin="naked">
        Annuleren
      </AuButton>
      <AuButton
        @skin="primary"
        @loading={{this.saveAgendaitem.isRunning}}
        @disabled={{not this.formValid}}
        {{on "click" this.saveAgendaitem.perform}}
      >
        Opslaan
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>

<DeleteConfirmationModal
  @modalOpen={{this.isOpenDeleteAgendaitemModal}}
  @onClose={{this.closeDeleteAgendaitemModal}}
  @onConfirm={{this.deleteAgendaitem.perform}}
  @isLoading={{this.deleteAgendaitem.isRunning}}
>
  <:title>
    Agendapunt verwijderen
  </:title>
  <:body>
    Bent u zeker dat u dit agendapunt wil verwijderen?
  </:body>
</DeleteConfirmationModal>