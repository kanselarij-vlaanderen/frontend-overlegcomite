{{page-title "Agenda"}}

<div class="au-u-background-gray-100 au-u-flex au-u-scrollable au-u-flex-grow">
  <div class="{{if this.isIndexRoute 'au-u-flex-grow' 'oc-agendaitem-list-sidebar au-u-scrollable'}}">
    {{#if @model}}
      <AgendaitemsListNavigation
        @agendaitemGroups={{@model}}
        class="oc-agendaitem-list
          {{if this.isIndexRoute 'au-u-margin au-o-flow'}}"
      />
    {{else}}
      <div class="oc-container">
        <AuAlert @title="Geen agendapunten" @icon="circle-info">
          Deze vergadering heeft nog geen agendapunten
        </AuAlert>
      </div>
    {{/if}}
  </div>
  {{#unless this.isIndexRoute}}
    <div class="au-u-background-white au-u-scrollable au-u-flex-grow">
      {{outlet}}
    </div>
  {{/unless}}
</div>