{{page-title "Nieuwe Meeting"}}

<AuModal @modalOpen={{true}} @overflow={{true}}>
  <:title>
    Nieuwe vergadering
  </:title>
  <:body>
    <MeetingForm @meeting={{@model}} />
  </:body>
  <:footer>
    <AuToolbar>
      <AuLink @route="meetings">
        Annuleren
      </AuLink>
      <AuButton
        @loading={{this.saveState.isPending}}
        {{on "click" this.saveMeeting}}>
        Aanmaken
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>