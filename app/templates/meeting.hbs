{{page-title "Vergadering"}}

<AuToolbar @size="medium" @skin="tint" as |Group|>
  <Group>
    <AuHeading @skin={{4}}>
      Agenda van {{datetime-format @model.startedAt}}
    </AuHeading>
  </Group>
</AuToolbar>
<AuToolbar @size="medium" @skin="tint" @border="bottom" as |Group|>
  <Group>
    <AuTabs @reversed={{true}} as |Tab|>
      <Tab>
        <AuLink @route="meetings" @icon="hierarchal-back" @hideText={{true}}>
          Back
        </AuLink>
      </Tab>
      <Tab>
        <AuLink @route="meeting.agendaitems" @model={{@model}}>Overzicht</AuLink>
      </Tab>
      {{#if (this.routeIsActive "meeting.agendaitem")}}
        <Tab>
          <AuLink @route={{this.target.currentRouteName}}>
            Detail
          </AuLink>
        </Tab>
      {{/if}}
      <Tab>
        <AuLink>Documenten</AuLink>
      </Tab>
    </AuTabs>
  </Group>
  <Group>
    <AuButtonGroup>
      <AuLink @skin="button" @route="meeting.agendaitems.new">
        Nieuw agendapunt
      </AuLink>
      <AuDropdown
        @title="Acties"
        @skin="secondary">
        <AuButton @skin="link" role="menuitem">Agenda Vrijgeven</AuButton>
        <AuButton @skin="link" role="menuitem">Notificaties Vrijgeven</AuButton>
        <AuHr/>
        <AuLink @route="meeting.edit" role="menuitem">
          Vergadering Wijzigen
        </AuLink>
        <AuButton
          @skin="link" @alert={{true}} role="menuitem"
          {{on "click" this.openDeleteModal}}>
          Vergadering Verwijderen
        </AuButton>
      </AuDropdown>
    </AuButtonGroup>
  </Group>
</AuToolbar>

<AuModal
  @modalOpen={{this.deleteModalOpen}}
  @closeModal={{this.closeDeleteModal}}>
  <:title>
    Vergadering verwijderen
  </:title>
  <:body>
    Bent u zeker dat u deze vergadering inclusief agendapunten wil verwijderen?
  </:body>
  <:footer>
    <AuToolbar as |Group|>
      <Group>
        <AuButton @skin="link"
          {{on "click" this.closeDeleteModal}}>
          Annuleer
        </AuButton>
      </Group>
      <Group>
        <AuButton @alert={{true}} @icon="trash"
          {{on "click" this.deleteMeeting}}
          @loading={{this.deleteState.isPending}}>
          Verwijderen
        </AuButton>
      </Group>
    </AuToolbar>
  </:footer>
</AuModal>

{{outlet}}