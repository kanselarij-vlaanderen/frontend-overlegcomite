{{page-title "Vergadering"}}

<div class="oc-meeting-header">
  <AuToolbar @size="medium" @skin="tint" as |Group|>
    <Group>
      <AuHeading @skin={{4}}>
        Agenda van
        {{format-datetime @model.startedAt "oc-long"}}
      </AuHeading>
      <div>
        <DistributionStatus
          @distribution={{this.agendaDistribution}}
          @entityName="Agenda"
          />
        <DistributionStatus
          @distribution={{this.notificationsDistribution}}
          @entityName="Notificaties"
          />
      </div>
    </Group>
  </AuToolbar>
  <AuToolbar @size="medium" @skin="tint" @border="bottom" as |Group|>
    <Group>
      <AuTabs @reversed={{true}} as |Tab|>
        <Tab>
          <AuLink @route="meetings" @icon="hierarchal-back" @hideText={{true}}>
            Back
          </AuLink>
        </Tab>
        <Tab>
          <AuLink
            @route="meeting.agendaitems.index"
            @model={{@model.id}}
          >Overzicht</AuLink>
        </Tab>
        {{#if (this.routeIsActive "meeting.agendaitems.agendaitem")}}
          <Tab>
            <AuLink @route={{this.target.currentRouteName}}>
              Detail
            </AuLink>
          </Tab>
        {{/if}}
        <Tab>
          <AuLink @route="meeting.documents">Documenten</AuLink>
        </Tab>
      </AuTabs>
    </Group>
    <Group>
      <AuButtonGroup>
        <AuButton
          @skin="primary"
          @icon="plus"
          {{on "click" this.openNewAgendaitemModal}}
        >
          Nieuw agendapunt
        </AuButton>
        <AuDropdown @title="Acties" @alignment="right" @skin="secondary">
          <AuButton
            {{on "click" (fn this.runDistribution this.agendaDistribution)}}
            @skin="link"
            role="menuitem"
          >
            Agenda vrijgeven
          </AuButton>
          <AuButton
            {{on
              "click"
              (fn this.runDistribution this.notificationsDistribution)
            }}
            @skin="link"
            role="menuitem"
          >
            Notificaties vrijgeven
          </AuButton>
          <AuHr />
          <AuButton
            @skin="link"
            role="menuitem"
            {{on "click" this.openEditMeetingModal}}
          >
            Vergadering wijzigen
          </AuButton>
          <AuButton
            @skin="link"
            @alert={{true}}
            role="menuitem"
            {{on "click" this.openDeleteMeetingModal}}
          >
            Vergadering verwijderen
          </AuButton>
        </AuDropdown>
      </AuButtonGroup>
    </Group>
  </AuToolbar>
</div>

<AuModal
  @modalOpen={{this.isOpenEditMeetingModal}}
  @closeModal={{this.cancelEditMeeting}}
  @overflow={{true}}
>
  <:title>
    Vergadering wijzigen
  </:title>
  <:body>
    <MeetingForm @meeting={{@model}} />
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.cancelEditMeeting}} @skin="naked">
        Annuleren
      </AuButton>
      <AuButton
        @skin="primary"
        @loading={{this.saveMeeting.isRunning}}
        {{on "click" this.saveMeeting.perform}}
      >
        Opslaan
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>

<DeleteConfirmationModal
  @modalOpen={{this.isOpenDeleteMeetingModal}}
  @onClose={{this.closeDeleteMeetingModal}}
  @onConfirm={{this.deleteMeeting.perform}}
  @isLoading={{this.deleteMeeting.isRunning}}
>
  <:title>
    Vergadering verwijderen
  </:title>
  <:body>
    Bent u zeker dat u deze vergadering inclusief agendapunten wil verwijderen?
  </:body>
</DeleteConfirmationModal>

{{#if this.isOpenNewAgendaitemModal}}
  <NewAgendaitemModal
    @modalOpen={{true}}
    @onSave={{this.goToAgendaitem}}
    @onCancel={{this.closeNewAgendaitemModal}}
    @meeting={{@model}}
  />
{{/if}}

{{outlet}}