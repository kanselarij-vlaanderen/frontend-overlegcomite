{{page-title "Wijzigen"}}

<AuModal
  @overflow={{false}}
  @modalOpen={{true}}
  @closeModal={{this.closeModal}}>
  <:title>
    Agendapunt wijzigen
  </:title>
  <:body>
    <AgendaitemForm @agendaitem={{@model}} />
  </:body>
  <:footer>
    <AuToolbar>
      <AuLink @route="meeting.agendaitem" {{on "click" this.closeModal}}>
        Annuleren
      </AuLink>
      <AuButton
        @loading={{this.updateState.isPending}}
        {{on "click" this.updateAgendaitem}}>
        Opslaan
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>