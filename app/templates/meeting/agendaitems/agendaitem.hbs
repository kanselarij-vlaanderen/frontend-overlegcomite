<div class="au-u-padding">
  <AuToolbar @size="medium" @border="bottom" as |Group|>
    <Group>
      <AuHeading @skin={{4}}>
        {{@model.subject}}
      </AuHeading>
      {{#if @model.case.identifier}}
        <AuPill @icon="document" >
          {{@model.case.identifier}}
        </AuPill>
      {{/if}}
    </Group>
    <Group>
      <AuButton @skin="secondary" @icon="pencil"
        {{on "click" this.openEditAgendaitemModal}}>
        Wijzigen
      </AuButton>
      <AuButton @skin="secondary" @icon="trash" @alert={{true}}
        {{on "click" this.openDeleteAgendaitemModal}}>
        Verwijderen
      </AuButton>
    </Group>
  </AuToolbar>
</div>

<div class="au-o-layout au-o-flow">
  <AuHeading @level={{3}} @skin={{3}}>
    Notificatie
  </AuHeading>
  {{#if @model.notification }}
    <DocumentCard @document={{@model.notification}}/>
  {{/if}}
  <AuHeading @level={{3}} @skin={{3}}>
    Documenten
  </AuHeading>
  {{#each @model.documents as |document| }}
    <DocumentCard @document={{document}}/>
  {{/each}}
</div>

<AuModal
  @modalOpen={{this.isOpenEditAgendaitemModal}}
  @closeModal={{this.cancelEditAgendaitem}}
  @overflow={{true}}>
  <:title>
    Agendapunt wijzigen
  </:title>
  <:body>
    <Await @promise={{@model.case}}>
      <:pending>
        <AuLoader @centered={{true}}>
          Aan het laden
        </AuLoader>
      </:pending>
      <:success as |case|>
        <AgendaitemForm @agendaitem={{@model}} @case={{case}} />
      </:success>
    </Await>
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.cancelEditAgendaitem}} @skin="naked">
        Annuleren
      </AuButton>
      <AuButton @skin="primary"
        @loading={{this.saveAgendaitem.isRunning}}
        {{on "click" this.saveAgendaitem.perform}}>
        Opslaan
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>

<DeleteConfirmationModal
  @modalOpen={{this.isOpenDeleteAgendaitemModal}}
  @onClose={{this.closeDeleteAgendaitemModal}}
  @onConfirm={{this.deleteAgendaitem.perform}}
  @isLoading={{this.deleteAgendaitem.isRunning}}>
  <:title>
    Agendapunt verwijderen
  </:title>
  <:body>
    Bent u zeker dat u dit agendapunt wil verwijderen?
  </:body>
</DeleteConfirmationModal>