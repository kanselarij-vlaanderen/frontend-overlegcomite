<AuModal @modalOpen={{@modalOpen}} @closeModal={{this.cancelNewAgendaitem}}>
  <:title>
    Nieuw agendapunt
  </:title>
  <:body>
    {{#if this.init.isRunning}}
      <AuLoader @centered={{true}}>
        Aan het laden
      </AuLoader>
    {{else}}
      <AgendaitemForm
        @agendaitem={{this.agendaitem}}
        @caseIdentifier={{this.caseIdentifier}}
      />
    {{/if}}
  </:body>
  <:footer>
    <AuToolbar>
      <AuButton {{on "click" this.cancelNewAgendaitem}} @skin="naked">
        Annuleren
      </AuButton>
      <AuButton
        @loading={{this.saveNewAgendaitem.isRunning}}
        @disabled={{this.saveButtonDisabled}}
        {{on "click" this.saveNewAgendaitem.perform}}
      >
        Aanmaken
      </AuButton>
    </AuToolbar>
  </:footer>
</AuModal>