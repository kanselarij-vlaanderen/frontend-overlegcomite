<AuButton
  @skin={{@skin}}
  @size={{@size}}
  @icon={{@icon}}
  @iconAlignment={{@iconAlignment}}
  @hideText={{@hideText}}
  @width={{@width}}
  @wrap={{@wrap}}
  @alert={{@alert}}
  @disabled={{@disabled}}
  @loading={{@loading}}
  @loadingMessage={{@loadingMessage}} {{on "click" this.openModal}}
  ...attributes>
  {{yield to="button"}}

  <AuModal
    @overflow={{@modalOverflow}}
    @padding={{@modalPadding}}
    @size={{@modalSize}}
    @modalOpen={{this.modalOpen}}
    @closeModal={{this.closeModal}}>
    <:title>{{yield to="title"}}</:title>
    <:body>{{yield to="body"}}</:body>
    <:footer>{{yield this.cancelModal this.closeModal to="footer"}}</:footer>
  </AuModal>
</AuButton>