{{#if @distribution.hasStarted}}
  {{#if @distribution.loading}}
    <span>
      <AuLoader @inline={{true}} @hideMessage={{false}}>
        {{@entityName}} in vrijgave
       </AuLoader>
    </span>
  {{else if @distribution.finished}}
    <span class="au-u-success">
      {{@entityName}} vrijgegeven
      <AuIcon @icon="check" />
    </span>
  {{else}}
    <span class="au-u-error">
      {{@entityName}} vrijgeven mislukt
      <AuIcon @icon="alert-circle" />
    </span>
  {{/if}}
{{/if}}
