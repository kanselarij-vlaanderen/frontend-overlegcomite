{{#if @documentVersion}}
  <Await @promise={{@documentVersion.accessLevel}}>
    <:success as |accessLevel|>
      <AccessLevelPill
        @accessLevel={{accessLevel}}
        @onSave={{this.saveAccessLevel}}
      />
    </:success>
  </Await>
  <AuPill
    @skin={{if @documentVersion.confidential "warning" "default"}}
    @actionIcon={{if @documentVersion.confidential "lock-closed" "lock-open"}}
    @onClickAction={{this.toggleConfidential}}
  >
    {{#if @documentVersion.confidential}}
      Vertrouwelijk
    {{else}}
      Openbaar
    {{/if}}
  </AuPill>
{{/if}}
<AuDropdown
  @title="Meer opties"
  @icon="three-dots"
  @size="large"
  @skin="naked"
  @hideText="true"
  class="au-u-flex"
>
  {{#if @document}}
    <AuButton
      {{on "click" (fn (mut this.isAddingDocumentVersion) true)}}
      @skin="link"
      role="menuitem"
    >
      Nieuwe versie uploaden
    </AuButton>
  {{/if}}
  <AuHr />
  {{#if @documentVersion}}
    <AuButton
      {{on "click" (fn this.deleteDocumentVersion @documentVersion)}}
      @skin="link"
      @alert={{true}}
      role="menuitem"
    >
      Versie verwijderen
    </AuButton>
  {{/if}}
  {{#if @document}}
    <AuButton
      {{on "click" this.deleteDocument}}
      @skin="link"
      @alert={{true}}
      role="menuitem"
    >
      Document verwijderen
    </AuButton>
  {{/if}}
</AuDropdown>

<FileUploadModal
  @modalOpen={{this.isAddingDocumentVersion}}
  @multiple={{false}}
  @onSave={{this.addDocumentVersion}}
  @onCancel={{fn (mut this.isAddingDocumentVersion) false}}
/>