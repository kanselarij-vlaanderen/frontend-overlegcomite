{{#if @documentVersion}}
  <Await @promise={{@documentVersion.accessLevel}}>
    <:success as |accessLevel|>
      <AccessLevelPill
        @accessLevel={{accessLevel}}
        @onSave={{if (user-may "manage-document-access-levels") this.saveAccessLevel}}
      />
    </:success>
  </Await>
  {{#if (user-may "manage-document-access-levels")}}
    <AuPill
      @skin={{if @documentVersion.confidential "warning" "default"}}
      @actionIcon={{if @documentVersion.confidential "lock-closed" "lock-open"}}
      @onClickAction={{this.toggleConfidential}}
    >
      {{#if @documentVersion.confidential}}
        Vertrouwelijk
      {{else}}
        Openbaar
      {{/if}}
    </AuPill>
  {{else}}
    <AuPill @skin={{if @documentVersion.confidential "warning" "default"}}>
      {{#if @documentVersion.confidential}}
        Vertrouwelijk
      {{else}}
        Openbaar
      {{/if}}
    </AuPill>
  {{/if}}
{{/if}}
{{#if (user-may "manage-documents")}}
  <AuDropdown
    @title="Meer opties"
    @icon="three-dots"
    @size="large"
    @skin="naked"
    @hideText="true"
    class="au-u-flex"
  >
    {{#if @document}}
      <AuButton
        {{on "click" (fn (mut this.isAddingDocumentVersion) true)}}
        @skin="link"
        role="menuitem"
      >
        Nieuwe versie uploaden
      </AuButton>
    {{/if}}
    <AuHr />
    {{#if @documentVersion}}
      <AuButton
        {{on "click" (fn this.deleteDocumentVersion @documentVersion)}}
        @skin="link"
        @alert={{true}}
        role="menuitem"
      >
        Versie verwijderen
      </AuButton>
    {{/if}}
    {{#if @document}}
      <AuButton
        {{on "click" this.deleteDocument}}
        @skin="link"
        @alert={{true}}
        role="menuitem"
      >
        Document verwijderen
      </AuButton>
    {{/if}}
  </AuDropdown>
{{/if}}

<FileUploadModal
  @modalOpen={{this.isAddingDocumentVersion}}
  @multiple={{false}}
  @onSave={{this.addDocumentVersion}}
  @onCancel={{fn (mut this.isAddingDocumentVersion) false}}
/>