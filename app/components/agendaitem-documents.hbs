<AuHeading @level={{3}} @skin={{3}}>
  Notificatie
</AuHeading>
<div class="au-o-flow au-o-flow--small">
  {{#if @agendaitem.notification }}
    <Await @promise={{@agendaitem.notification}}>
      <:pending>
        <AuLoader />
      </:pending>
      <:success as |notification|>
        <DocumentCard @document={{notification}}/>
      </:success>
    </Await>
  {{else}}
    <AuAlert
      @title="Geen notificatie beschikbaar"
      @icon="circle-info">
      Dit agendapunt heeft nog geen notificatie.
    </AuAlert>
    <AuButton
      {{on "click" this.openNotificationUploadModal}}
      @disabled={{this.init.isRunning}}
      @icon="plus"
      @skin="secondary">
      Notificatie toevoegen
    </AuButton>
  {{/if}}
</div>
<AuHeading @level={{3}} @skin={{3}}>
  Documenten
</AuHeading>
<div class="au-o-flow au-o-flow--small">
  {{#each @agendaitem.documents as |document| }}
    <DocumentCard @document={{document}}/>
  {{/each}}
  {{#if (not @agendaitem.documents)}}
    <AuAlert
      @title="Geen documenten beschikbaar"
      @icon="circle-info">
      Dit agendapunt heeft nog geen documenten.
    </AuAlert>
  {{/if}}
  <AuButton
    {{on "click" this.openDocumentUploadModal}}
    @disabled={{this.init.isRunning}}
    @icon="plus"
    @skin="secondary">
    Documenten toevoegen
  </AuButton>
  <DocumentUploadModal
    @modalOpen={{this.isDocumentUploadModalOpen}}
    @onSave={{this.saveDocuments}}
    @onCancel={{fn (mut this.isDocumentUploadModalOpen) false}}
    @defaultDocumentAttrs={{this.defaultDocumentAttrs}}
    @multiple={{true}}/>
</div>
