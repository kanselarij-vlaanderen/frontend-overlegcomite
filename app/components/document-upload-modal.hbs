<AuModal @modalOpen={{@modalOpen}} @closeModal={{this.cancelDocuments}}>
  <:title>Documenten opladen</:title>
  <:body>
    <div class="au-o-flow au-o-flow--small">
      {{#if this.saveDocuments.isRunning}}
        <AuLoader @message="Aan het opslaan" />
      {{else}}
        {{#if (or @multiple (not this.documents))}}
          <AuFileUpload
            @endpoint={{this.endpoint}}
            @onFinishUpload={{this.createDocument}}
            @multiple={{@multiple}}
          />
        {{/if}}
        {{#each this.documents as |document|}}
          <AuCard @flex={{true}} as |c|>
            <c.header @badgeIcon="file">
              <Await @promise={{document.documentVersions}}>
                <:success as |documentVersions|>
                  {{#let (get documentVersions 0) as |version|}}
                    <AuHeading @skin="4">
                      {{version.file.filename}}
                    </AuHeading>
                    <p>
                      {{format-file-size version.file.size}}
                      -
                      {{version.file.extension}}
                    </p>
                  {{/let}}
                </:success>
              </Await>
            </c.header>
            <c.content class="au-c-form">
              {{#let (unique-id) as |id|}}
                <AuFormRow @alignment="inline">
                  <AuLabel for="document-version-name-{{id}}" class="au-u-1-6">
                    Naam
                  </AuLabel>
                  <AuInput
                    id="document-name-{{id}}"
                    {{on "input" (with-value (fn (mut document.name)))}}
                    value={{document.name}}
                  />
                </AuFormRow>
                <AuFormRow @alignment="inline">
                  <AuLabel for="document-type-{{id}}" class="au-u-1-6">
                    Type
                  </AuLabel>
                  <Await @promise={{document.type}}>
                    <:success as |selectedDocumentType|>
                      <PowerSelect
                        id="document-type-{{id}}"
                        @disabled={{this.init.isRunning}}
                        @selected={{selectedDocumentType}}
                        @onChange={{fn (mut document.type)}}
                        @options={{this.documentTypes}}
                        @allowClear={{true}}
                        class="au-c-input"
                        as |type|
                      >
                        {{type.label}}
                      </PowerSelect>
                    </:success>
                  </Await>
                </AuFormRow>
              {{/let}}
            </c.content>
          </AuCard>
        {{/each}}
      {{/if}}
    </div>
  </:body>
  <:footer>
    <AuToolbar as |Group|>
      <Group>
        <AuButton
          {{on "click" this.cancelDocuments}}
          @disabled={{this.saveDocuments.isRunning}}
          @skin="naked"
        >
          Annuleren
        </AuButton>
      </Group>
      <Group>
        <AuButton
          {{on "click" this.saveDocuments.perform}}
          @disabled={{this.saveDocuments.isRunning}}
        >
          Aanmaken
        </AuButton>
      </Group>
    </AuToolbar>
  </:footer>
</AuModal>