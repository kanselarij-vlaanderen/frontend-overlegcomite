{{#if @version}}
  <Await @promise={{@version.accessLevel}}>
    <:success as |accessLevel|>
      <AccessLevelPill
        @accessLevel={{accessLevel}}
        @onCancel={{this.cancelEditingAccessLevel}}
        @onSave={{this.saveAccessLevel}}
      />
    </:success>
  </Await>
  <AuPill
    @skin={{if @version.confidential "warning" "default"}}
    @actionIcon={{if @version.confidential "lock-closed" "lock-open"}}
    @onClickAction={{this.toggleConfidential}}
  >
    {{#if @version.confidential}}
      Vertrouwelijk
    {{else}}
      Openbaar
    {{/if}}
  </AuPill>
{{/if}}
<AuDropdown @title="Meer opties" @icon="three-dots" @hideText="true">
  {{#if this.file}}
    <AuLinkExternal
      href={{document-version/download-link @document this.file}}
      download={{document-version/download-filename @document this.file}}
      role="menuitem"
    >
      Document downloaden
    </AuLinkExternal>
  {{/if}}
  {{#if @document}}
    <AuButton
      {{on "click" (fn (mut this.isAddingVersion) true)}}
      @skin="link"
      role="menuitem"
    >
      Nieuwe versie uploaden
    </AuButton>
    <AuButton {{on "click" @onEditDocumentName}} @skin="link" role="menuitem">
      Documentnaam wijzigen
    </AuButton>
  {{/if}}
  <AuHr />
  {{#if @version}}
    <AuButton
      {{on "click" (fn this.deleteVersion @version)}}
      @skin="link"
      @alert={{true}}
      role="menuitem"
    >
      Versie verwijderen
    </AuButton>
  {{/if}}
  {{#if @document}}
    <AuButton
      {{on "click" (fn this.deleteDocument @document)}}
      @skin="link"
      @alert={{true}}
      role="menuitem"
    >
      Document verwijderen
    </AuButton>
  {{/if}}
</AuDropdown>

<FileUploadModal
  @modalOpen={{this.isAddingVersion}}
  @multiple={{false}}
  @onSave={{this.addVersion}}
  @onCancel={{fn (mut this.isAddingVersion) false}}
/>