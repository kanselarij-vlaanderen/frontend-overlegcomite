<form class="au-c-form">
  <div class="au-o-grid">
    <AuFormRow class="au-o-grid__item au-u-1-2@xsmall">
      <AuLabel for="agendaitem-priority">
        Volgnummer
      </AuLabel>
      <Input
        id="agendaitem-priority"
        @value={{this.agendaitem.priority}}
        class="au-c-input"
        @type="number" />
    </AuFormRow>
    <AuFormRow class="au-o-grid__item au-u-1-2@xsmall">
      <AuLabel for="agendaitem-subpriority">
        Onderdeel
      </AuLabel>
      <Input
        id="agendaitem-subpriority"
        @value={{this.agendaitem.subPriority}}
        class="au-c-input"
        />
    </AuFormRow>
  </div>
  <AuFormRow>
    <AuLabel for="agendaitem-case">
      Dossiernummer
    </AuLabel>
    <Input
      id="agendaitem-case"
      @value={{this.agendaitem.case.identifier}}
      class="au-c-input"
      placeholder="bv. 2015C80030.002"
      />
  </AuFormRow>
  <AuFormRow>
    <AuLabel for="agendaitem-submitters">
      Indieners
    </AuLabel>
    {{! TODO: Power select }}
    <ul>
      {{#each this.agendaitem.submitters as |submitter|}}
        <li>
          {{submitter.name}}
        </li>
      {{/each}}
    </ul>
  </AuFormRow>
  <AuFormRow>
    <AuLabel for="agendaitem-subject">
      Titel
    </AuLabel>
    <Input
      id="agendaitem-subject"
      @value={{this.agendaitem.subject}}
      class="au-c-input au-c-input--block"
      />
  </AuFormRow>
</form>