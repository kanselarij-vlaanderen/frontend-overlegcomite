<AuCard @flex={{true}} @size="small" class="oc-document-card" as |c|>
  <c.header @badgeIcon="file">
    <AuToolbar class="au-u-flex--vertical-end" as |Group|>
      <Group>
        <AuHeading @level="6" @skin="6">
          {{or @document.type.label "Document (Overig)"}}
        </AuHeading>
      </Group>
      <Group class="au-u-flex--vertical-end">
        {{#unless this.init.isRunning}}
          <DocumentVersionButtons
            @version={{this.latestVersion}}
            @document={{@document}}
            @onEditDocumentName={{fn (mut this.isEditingDocumentName) true}}
          />
        {{/unless}}
      </Group>
    </AuToolbar>
    <div>
      {{#if this.isEditingDocumentName}}
        <AuInput
          id="document-name-{{@document.id}}"
          {{on "input" (with-value (fn (mut @document.name)))}}
          value={{@document.name}}
        />
        <AuButton
          {{on "click" this.saveDocumentName}}
          @icon="check"
          @skin="naked"
          @hideText="true"
        >
          Opslaan
        </AuButton>
        <AuButton
          {{on "click" this.cancelEditingDocumentName}}
          @icon="cross"
          @skin="naked"
          @hideText="true"
          @alert={{true}}
        >
          Annuleren
        </AuButton>
      {{else}}
        {{#if this.latestVersion}}
          <AuHeading @level="5" @skin="5">
            <AuLink
              @skin="bold"
              @route="view-document"
              @model={{this.latestVersion}}
              target="_blank"
            >
              {{format-versioned-document-name this.latestVersion @document}}
            </AuLink>
          </AuHeading>
        {{else}}
          <AuHeading @level="5" @skin="5">
            {{@document.name}}
          </AuHeading>
          (Geen versies beschikbaar)
        {{/if}}
      {{/if}}
    </div>
    <p class="au-u-muted">
      Aangemaakt op
      <span>
        {{format-datetime @document.created}}
      </span>
    </p>
  </c.header>
  {{#if this.hasMultipleVersions}}
    <c.footer>
      <details class="oc-c-card-footer--details">
        <summary class="oc-c-card-footer--summary">
          <AuIcon @icon="chevron-right" />
          Alle versies
        </summary>
        <ol
          class="oc-c-card-footer--content oc-c-timeline au-c-list au-c-list--vertical au-o-flow"
        >
          {{#each this.sortedDocumentVersions as |version index|}}
            <li
              class="oc-c-timeline__item au-c-list__item au-u-flex au-u-flex--row"
            >
              <AuIcon
                @icon={{if index "clock-rewind" "chevron-right"}}
                class="au-o-box au-o-box--small"
              />
              <div>
                <p class="au-u-medium">
                  {{format-versioned-document-name version @document}}
                </p>
                <p class="au-u-muted">
                  {{format-datetime version.created}}
                </p>
              </div>
              {{#if index}}
                <div class="au-u-flex-self-start au-u-margin-left">
                  <DocumentVersionButtons @version={{version}} />
                </div>
              {{/if}}
            </li>
          {{/each}}
        </ol>
      </details>
    </c.footer>
  {{/if}}
</AuCard>