  <AuCard
    @flex={{true}}
    class=""
    as |c| >
    <c.header
      @badgeIcon="file">
      <AuToolbar as |Group|>
        <Group>
          <div class="au-o-flow">
            <p class="au-c-heading au-c-heading--4">
              Notificatie
            </p>
          </div>
        </Group>
        <Group>
          <AuPill>
            Geen toegangsniveau
          </AuPill>
          <AuButton @icon="lock-open" @skin="naked" @hideText="true">
            Wissel openbaarheid
          </AuButton>
          <AuButton @icon="book" @skin="naked" @hideText="true">
            Lees document
          </AuButton>
          <AuDropdown
            @title="Meer opties"
            @icon="three-dots" @hideText="true">
            <AuButton @skin="link" role="menuitem">
              Document downloaden
            </AuButton>
            <AuButton @skin="link" role="menuitem">
              Nieuwe versie uploaden
            </AuButton>
            <AuButton @skin="link" role="menuitem">
              Documentnaam wijzigen
            </AuButton>
            <AuHr />
            <AuButton @skin="link" @alert={{true}} role="menuitem">
              Versie verwijderen
            </AuButton>
            <AuButton @skin="link" @alert={{true}} role="menuitem">
              Document verwijderen
            </AuButton>
          </AuDropdown>
        </Group>
      </AuToolbar>
      <span>
        OC 2026 1106 NOT PUNT 01
      </span>
    </c.header>
    <c.footer>
      <details class="oc-c-card-footer--details">
        <summary class="oc-c-card-footer--summary">
          <AuIcon @icon="chevron-right" /> Alle versies
        </summary>
        <ul class="oc-c-card-footer--content">
          <li>Versie 1</li>
          <li>Versie 2</li>
        </ul>
      </details>
    </c.footer>
  </AuCard>
