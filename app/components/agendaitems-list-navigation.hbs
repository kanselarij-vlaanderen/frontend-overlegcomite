<nav ...attributes>
  {{#each @agendaitemGroups as |agendaitemGroup|}}
    <AuPanel as |Section|>
      <Section
        class="oc-agendaitem-list-group-header au-u-background-yellow-300"
      >
        {{! TODO: Make heading sticky on scroll }}
        <AuToolbar as |Group|>
          <Group>
            <AuHeading @level={{3}} @skin={{6}}>
              {{format-submitter-names agendaitemGroup.submitters}}
            </AuHeading>
          </Group>
        </AuToolbar>
      </Section>
      <Section
        class="oc-agendaitem-list-group-content au-u-background-gray-100"
      >
        <AuList as |Item|>
          {{#each agendaitemGroup.agendaitems as |agendaitem|}}
            <Item class="au-u-background-white">
              <LinkTo
                @route="meetings.meeting.agendaitems.agendaitem"
                @model={{agendaitem.id}}
              >
                <span>{{agendaitem.priority}}.{{agendaitem.subPriority}}</span>
                <span class="au-u-flex au-u-flex--column au-u-flex--vertical-start au-u-flex--spaced-tiny">
                  <span>{{if agendaitem.subject agendaitem.subject "Naamloos"}}</span>
                  <Await @promise={{agendaitem.case}}>
                    <:success as |case|>
                      {{#if case.identifier}}
                        <AuPill @skin="border">
                          {{case.identifier}}
                        </AuPill>
                      {{/if}}
                    </:success>
                  </Await>
                </span>
              </LinkTo>
            </Item>
          {{/each}}
        </AuList>
      </Section>
    </AuPanel>
  {{/each}}
</nav>