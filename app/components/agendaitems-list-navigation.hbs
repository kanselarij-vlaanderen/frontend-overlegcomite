<nav ...attributes>
  {{#each-in @agendaitemGroups as |submitter agendaitems|}}
    <AuPanel as |Section|>
      <Section class="oc-agendaitem-list-group-header au-u-background-yellow-300">
        {{! TODO: Make heading sticky on scroll }}
        <AuToolbar as |Group|>
          <Group>
            <AuHeading @level={{3}} @skin={{6}}>
              {{if submitter submitter "Geen indiener"}}
            </AuHeading>
          </Group>
        </AuToolbar>
      </Section>
      <Section class="oc-agendaitem-list-group-content">
        <AuList as |Item|>
          {{#each agendaitems as |agendaitem|}}
            <Item>
              <LinkTo
                @route="meeting.agendaitems.agendaitem"
                @model={{agendaitem.id}}>
                <span>{{agendaitem.priority}}.{{agendaitem.subPriority}}</span>
                {{if agendaitem.subject agendaitem.subject "Naamloos"}}
              </LinkTo>
            </Item>
          {{/each}}
        </AuList>
      </Section>
    </AuPanel>
  {{/each-in}}
</nav>