<nav ...attributes>
  {{#each-in @agendaitemGroups as |submitter agendaitems|}}
    <AuPanel as |Section|>
      <Section class="au-u-background-yellow-300">
        {{! TODO: Make heading sticky on scroll }}
        <AuToolbar as |Group|>
          <Group>
            <AuHeading @level={{3}} @skin={{6}}>
              {{if submitter submitter "Geen indiener"}}
            </AuHeading>
          </Group>
        </AuToolbar>
      </Section>
      <Section>
        <AuList @divider={{true}} as |Item|>
          {{#each agendaitems as |agendaitem|}}
            <Item class="au-u-padding-small">
              {{agendaitem.priority}}.{{agendaitem.subPriority}}
              {{! TODO: Add highlight (blue background) of selected agendaitem based on active route}}
              <AuLink
                @route="meeting.agendaitems.agendaitem"
                @model={{agendaitem.id}}
                @skin="button-naked">
                {{if agendaitem.subject agendaitem.subject "Naamloos"}}
              </AuLink>
            </Item>
          {{/each}}
        </AuList>
      </Section>
    </AuPanel>
  {{/each-in}}
</nav>