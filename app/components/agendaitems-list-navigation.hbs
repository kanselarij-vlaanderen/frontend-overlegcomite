<nav>
  <ul class="au-c-list-navigation">
    {{#each-in @agendaitemGroups as |submitter items|}}
      <li class="au-c-list-navigation__item au-c-navigation__item--section oc-c-sticky-header {{if @tint "oc-c-sticky-header--tint"}}">
        <AuHeading @level={{3}} @skin={{5}} class="au-c-list-navigation__section-title">
          {{if submitter submitter "Geen indiener"}}
        </AuHeading>
      </li>
      {{#each items as |item|}}
        <li class="au-c-list-navigation__item">
          <AuNavigationLink
            @route="meeting.agendaitem"
            @model={{item}}>
            {{ item.priority }}.{{item.subPriority}}&nbsp;{{ item.subject }}
          </AuNavigationLink>
        </li>
      {{/each}}
    {{/each-in}}
  </ul>
</nav>