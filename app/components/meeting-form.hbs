<form class="au-c-form">
  <AuFormRow>
    <AuLabel for="meeting-start-at-date">Datum</AuLabel>
    <AuDatePicker
      @id="meeting-start-at-date"
      @value={{this.startedAtDate}}
      @onChange={{this.setStartedAtDate}}
    />
  </AuFormRow>
  <AuFormRow>
    <AuLabel for="meeting-start-at-time">Tijd</AuLabel>
    <AuTimePicker
      @id="meeting-start-at-time"
      @hours={{this.startedAtHour}}
      @minutes={{this.startedAtMinute}}
      @onChange={{this.setStartedAtTime}}
      @showSeconds={{false}}
      @showNow={{false}}
    />
  </AuFormRow>
</form>